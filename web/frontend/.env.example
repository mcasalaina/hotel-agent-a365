# Copy this file to `.env.local` (or `.env`) and fill in your own Entra app registration values.
# Never commit real values here -- this file must only ever contain safe placeholders.
# None of these values are secret; this is a public client (Authorization Code + PKCE), so no
# client secret belongs in this app at all.

# Entra application (client) ID registered as a public client (SPA platform, PKCE).
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Entra authority URL for your tenant.
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000

# Redirect URI registered on the Entra app registration for this SPA (must match exactly).
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# Space-separated delegated scope(s) exposed by the hotel agent API for this browser client.
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/HotelAgent.Access

# Origin of the private backend proxy. Leave empty for same-origin deployments (recommended),
# in which case the app uses relative paths (e.g. `/api/config`) resolved against whatever origin
# served this page.
VITE_BACKEND_BASE_URL=
