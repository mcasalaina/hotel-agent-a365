{
  "schema_version": 2,
  "as_of_date": "2026-09-01",
  "temporal_contract": {
    "completed_departed_no_show": "check_out < 2026-09-01",
    "future": "check_in > 2026-09-01",
    "arriving": "check_in > 2026-09-01",
    "in_house": "check_in < 2026-09-01 < check_out, actual_check_out empty",
    "financial_postings": "posted_at and opened_at < 2026-09-01T00:00:00",
    "daily_occupancy": "historical actuals before boundary, confirmed on-books nights after",
    "room_revenue": "historical recognized room charges, zero on and after boundary",
    "last_checkout": "2027-04-01",
    "folio_balance": "total_charges + total_adjustments - total_payments + total_refunds"
  },
  "date_range": {
    "start": "2026-03-01",
    "end": "2027-03-31"
  },
  "required_tables": [
    "properties",
    "room_types",
    "rooms",
    "outlets",
    "amenities",
    "property_amenities",
    "guests",
    "reservations",
    "stays",
    "restaurant_reservations",
    "folios",
    "folio_transactions",
    "payments",
    "billing_disputes",
    "special_requests",
    "maintenance_requests",
    "work_orders",
    "daily_inventory",
    "daily_rates",
    "property_daily_metrics",
    "action_confirmations",
    "idempotency_records",
    "audit_events"
  ],
  "status_values": {
    "reservation": [
      "future",
      "arriving",
      "departed",
      "cancelled",
      "no_show",
      "completed",
      "in_house"
    ],
    "stay": [
      "completed",
      "in_house"
    ]
  },
  "payment_policy": {
    "card_mask_pattern": "**** **** **** 1234",
    "forbidden_columns": [
      "card_number",
      "cvv",
      "pan"
    ]
  }
}
