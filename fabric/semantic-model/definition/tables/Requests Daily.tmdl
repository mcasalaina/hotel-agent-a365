/// Guest special-request aggregates by reservation property, date requested and request type. Includes stored status counts and pending-reconciliation flags.
table 'Requests Daily'

	/// Total guest service requests created for the reporting grain.
	measure Requests = SUM('Requests Daily'[Total Requests])
		formatString: #,##0

	/// Open guest service requests still awaiting fulfillment.
	measure 'Open Request Count' = SUM('Requests Daily'[Open Requests])
		formatString: #,##0

	/// Requests that still need reconciliation with operations workflows.
	measure 'Pending Reconciliation Request Count' = SUM('Requests Daily'[Pending Reconciliation Requests])
		formatString: #,##0

	/// Technical hotel identifier obtained from the request's reservation; joins guest request aggregates to Property.
	column 'Property Id'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: property_id

	/// Calendar date the guest special request was made, derived from requested_at.
	column 'Service Date'
		dataType: dateTime
		summarizeBy: none
		sourceColumn: service_date

	/// Guest special-request classification used to group requests.
	column 'Request Type'
		dataType: string
		sourceColumn: request_type

	/// Count of guest special requests for the hotel/date/type group across all statuses.
	column 'Total Requests'
		dataType: int64
		isHidden
		sourceColumn: total_requests

	/// Count of guest special requests whose stored status is requested.
	column 'Open Requests'
		dataType: int64
		isHidden
		sourceColumn: open_requests

	/// Count of guest special requests whose stored status is confirmed.
	column 'Confirmed Requests'
		dataType: int64
		sourceColumn: confirmed_requests

	/// Count of guest special requests whose stored status is fulfilled.
	column 'Fulfilled Requests'
		dataType: int64
		sourceColumn: fulfilled_requests

	/// Count of requests flagged pending_reconciliation; flag count is independent of request status and can overlap status counts.
	column 'Pending Reconciliation Requests'
		dataType: int64
		isHidden
		sourceColumn: pending_reconciliation_requests

	partition 'Requests Daily' = entity
		mode: directLake
		source
			entityName: agg_requests_daily
			expressionSource: DL_HotelGuestServices
