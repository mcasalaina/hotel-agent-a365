table Property

column 'Property Id'
	dataType: string
	isHidden
	summarizeBy: none
	sourceColumn: property_id

column 'Property Name'
	dataType: string
	sourceColumn: name

column Region
	dataType: string
	sourceColumn: region

column City
	dataType: string
	sourceColumn: city

column Country
	dataType: string
	sourceColumn: country

column Currency
	dataType: string
	sourceColumn: currency

column 'Tax Rate'
	dataType: decimal
	formatString: 0.0000
	sourceColumn: tax_rate

partition Property = entity
	mode: directLake
	source
		entityName: ops_properties
		expressionSource: DL_HotelGuestServices
